# Copia este archivo a .env y completa los valores. No subas .env a git.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-bytes!!

# Base de datos: Supabase (PostgreSQL). Los esquemas identidad, vuelos y reservas ya existen.
DB_PROVIDER=postgres
# Connect > Session pooler (puerto 5432) o Direct connection. Reemplaza <PASSWORD>.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@<region-pooler-host>:5432/postgres

FLIGHTS_SERVICE_URL=http://localhost:5003
ADMIN_EMAILS=

# Solo si vuelves a SQLite o SQL Server (DB_PROVIDER=sqlite | sqlserver)
# SQLSERVER_SERVER=localhost
# SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# SQLSERVER_USER=
# SQLSERVER_PASSWORD=